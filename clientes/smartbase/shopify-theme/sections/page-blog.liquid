<section class="sb-section">
  <div class="sb-container">

    <div class="sb-section-header">
      <span class="sb-badge">{{ section.settings.badge }}</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(32px,5vw,56px);font-weight:800;line-height:1.1;margin-top:16px;">
        {{ section.settings.title }}<br><span class="sb-blue">{{ section.settings.title_blue }}</span>
      </h1>
      {% if section.settings.subtext != blank %}
        <p style="font-size:16px;font-weight:300;color:var(--text-secondary);margin-top:16px;max-width:560px;">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    {% if blog.articles_count == 0 or blog == blank %}
      <div style="text-align:center;padding:80px 0;border:var(--border-dashed);border-radius:var(--radius-card-lg);">
        <p style="font-size:32px;margin-bottom:12px;">✦</p>
        <p style="font-size:18px;font-weight:600;margin-bottom:8px;">em breve.</p>
        <p style="color:var(--text-secondary);font-size:14px;font-weight:300;">novidades e conteúdo Apple chegando por aqui.</p>
      </div>
    {% else %}
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px;">
        {% for article in blog.articles %}
          <a href="{{ article.url }}" style="display:block;background:var(--surface-1);border:var(--border-subtle);border-radius:var(--radius-card-lg);overflow:hidden;transition:transform 0.2s ease;text-decoration:none;color:inherit;">
            {% if article.image %}
              <div style="width:100%;aspect-ratio:16/9;overflow:hidden;">
                <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
              </div>
            {% endif %}
            <div style="padding:24px;">
              <p style="font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-muted);margin-bottom:10px;">{{ article.published_at | date: '%d/%m/%Y' }}</p>
              <h2 style="font-family:var(--font-display);font-size:20px;font-weight:700;margin-bottom:8px;line-height:1.3;">{{ article.title }}</h2>
              {% if article.excerpt != blank %}
                <p style="font-size:14px;font-weight:300;color:var(--text-secondary);line-height:1.6;">{{ article.excerpt | strip_html | truncate: 120 }}</p>
              {% endif %}
              <span style="display:inline-block;margin-top:16px;font-size:12px;font-weight:600;color:var(--blue-primary);">ler mais →</span>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "blog" },
    { "type": "text", "id": "title", "label": "Título", "default": "dicas e novidades" },
    { "type": "text", "id": "title_blue", "label": "Título em azul", "default": "do mundo Apple." },
    { "type": "textarea", "id": "subtext", "label": "Subtítulo (opcional)" }
  ],
  "presets": [{ "name": "Blog" }]
}
{% endschema %}
