<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% if request.page_type == 'index' %}
    <title>Smartbase — iPhone e Apple Original em Caxias do Sul, RS</title>
    <meta name="description" content="iPhones originais, novos e seminovos, com troca de aparelho estruturada. Importados do Paraguai, avaliados na hora. A melhor relação custo-benefício em Caxias do Sul, RS.">
  {% else %}
    <title>{{ page_title | default: shop.name }}</title>
    <meta name="description" content="{{ page_description | default: shop.description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Open Graph -->
  {% if request.page_type == 'index' %}
    <meta property="og:title" content="Smartbase — iPhone e Apple Original em Caxias do Sul, RS">
    <meta property="og:description" content="iPhones originais, novos e seminovos, com troca de aparelho estruturada. Importados do Paraguai, avaliados na hora. A melhor relação custo-benefício em Caxias do Sul, RS.">
  {% else %}
    <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
    <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
  {% endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  {% if settings.og_image %}
    <meta property="og:image" content="{{ settings.og_image | image_url: width: 1200 }}">
  {% endif %}

  <!-- Schema.org — Negócio local -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "ElectronicsStore"],
    "name": "Smartbase",
    "description": "Loja especializada em Apple em Caxias do Sul. iPhones originais, novos sob encomenda e seminovos avaliados. Trade-in estruturado com avaliação no mesmo dia.",
    "url": "{{ shop.url }}",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Caxias do Sul",
      "addressRegion": "RS",
      "addressCountry": "BR"
    },
    "sameAs": ["https://instagram.com/smartbase.br"]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,700;12..96,800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  {{ 'style.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>

  {% section 'header' %}

  <main>
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <script>
    (function () {
      var toggle = document.getElementById('sb-toggle');
      var nav = document.getElementById('sb-nav');
      if (!toggle || !nav) return;
      toggle.addEventListener('click', function () {
        var isOpen = nav.classList.toggle('sb-nav--open');
        toggle.textContent = isOpen ? '✕' : '☰';
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });
      nav.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          nav.classList.remove('sb-nav--open');
          toggle.textContent = '☰';
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        });
      });

      var dropdownToggle = document.querySelector('.sb-nav__dropdown-toggle');
      var dropdownMenu = document.querySelector('.sb-nav__dropdown-menu');
      if (dropdownToggle && dropdownMenu) {
        dropdownToggle.addEventListener('click', function (e) {
          e.stopPropagation();
          var isOpen = dropdownMenu.classList.toggle('sb-open');
          dropdownToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        document.addEventListener('click', function () {
          dropdownMenu.classList.remove('sb-open');
          dropdownToggle.setAttribute('aria-expanded', 'false');
        });
      }
    })();
  </script>

</body>
</html>
