<style>
  /* ── HERO SEMINOVOS ── */
  .sbsn-hero { padding: 80px 0 72px; border-bottom: var(--border-subtle); }
  .sbsn-hero__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .sbsn-hero__left { display: flex; flex-direction: column; gap: 24px; }
  .sbsn-hero h1 { font-family: var(--font-display); font-size: clamp(36px, 5vw, 64px); font-weight: 800; line-height: 1.05; }
  .sbsn-hero__sub { font-size: 16px; font-weight: 300; color: var(--text-secondary); line-height: 1.8; max-width: 440px; }
  .sbsn-hero__garantia { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; background: var(--blue-alpha-10); border: 1px solid var(--blue-alpha-30); border-radius: var(--radius-pill); font-size: 13px; font-weight: 600; color: var(--blue-primary); width: fit-content; }
  /* critérios */
  .sbsn-criterios { display: flex; flex-direction: column; gap: 10px; }
  .sbsn-criterios__title { font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px; }
  .sbsn-criterio { display: flex; align-items: center; gap: 12px; padding: 14px 18px; background: var(--surface-1); border: var(--border-subtle); border-left: 3px solid var(--blue-primary); border-radius: var(--radius-card); font-size: 14px; font-weight: 400; color: var(--text-secondary); }
  .sbsn-criterio svg { flex-shrink: 0; color: var(--blue-primary); }
  /* filtros */
  .sb-filtros { padding: 24px 0; border-bottom: var(--border-subtle); margin-bottom: 48px; }
  .sb-filtros__inner { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sb-filtro-btn { padding: 8px 18px; border: var(--border-subtle); border-radius: var(--radius-pill); background: transparent; color: var(--text-secondary); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.15s ease; }
  .sb-filtro-btn:hover, .sb-filtro-btn.active { background: var(--blue-primary); border-color: var(--blue-primary); color: #fff; }
  /* grid de produtos */
  .sb-seminovos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-bottom: 64px; }
  .sb-card-produto { background: var(--surface-1); border: var(--border-subtle); border-radius: var(--radius-card-lg); overflow: hidden; transition: transform 0.2s ease, border-color 0.2s ease; }
  .sb-card-produto:hover { transform: translateY(-4px); border-color: var(--surface-3); }
  .sb-card-produto__img { width: 100%; aspect-ratio: 4/3; background: var(--surface-2); display: flex; align-items: center; justify-content: center; border-bottom: var(--border-subtle); position: relative; }
  .sb-card-produto__img img { width: 100%; height: 100%; object-fit: cover; }
  .sb-card-produto__estado { position: absolute; top: 12px; right: 12px; padding: 4px 10px; background: var(--surface-1); border: var(--border-subtle); border-radius: var(--radius-badge); font-size: 10px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--text-secondary); }
  .sb-card-produto__body { padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .sb-card-produto__title { font-family: var(--font-display); font-size: 17px; font-weight: 700; }
  .sb-card-produto__specs { font-size: 12px; color: var(--text-secondary); font-weight: 400; }
  .sb-card-produto__price { font-family: var(--font-display); font-size: 22px; font-weight: 800; color: var(--blue-primary); margin-top: 4px; }
  .sb-card-produto__footer { padding: 0 20px 20px; }
  .sb-card-produto__footer .sb-btn { width: 100%; justify-content: center; }
  .sb-empty { text-align: center; padding: 80px 24px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .sb-empty h3 { font-family: var(--font-display); font-size: 22px; font-weight: 700; }
  .sb-empty p { font-size: 15px; color: var(--text-secondary); font-weight: 300; max-width: 400px; }
  @media (max-width: 768px) { .sbsn-hero__inner { grid-template-columns: 1fr; gap: 40px; } }
  @media (max-width: 640px) { .sb-seminovos-grid { grid-template-columns: 1fr; } }
</style>

<div class="sbsn-hero">
  <div class="sb-container">
    <div class="sbsn-hero__inner">

      <div class="sbsn-hero__left">
        <span class="sb-badge sb-badge--blue">seminovos avaliados</span>
        <h1>você sabe o que<br>está <span class="sb-blue">comprando.</span></h1>
        <p class="sbsn-hero__sub">antes de qualquer anúncio, cada aparelho passa por avaliação técnica. sem suposição, sem "como está". você compra com informação completa.</p>
        <div class="sbsn-hero__garantia">✓ 3 meses de garantia própria em todos os produtos</div>
      </div>

      <div>
        <p class="sbsn-criterios__title">o que a gente avalia em cada aparelho</p>
        <div class="sbsn-criterios">
          <div class="sbsn-criterio">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/></svg>
            saúde da bateria
          </div>
          <div class="sbsn-criterio">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/></svg>
            estado da tela
          </div>
          <div class="sbsn-criterio">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/></svg>
            estado da carcaça
          </div>
          <div class="sbsn-criterio">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/></svg>
            originalidade das peças
          </div>
          <div class="sbsn-criterio">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/></svg>
            histórico de trocas de componentes
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<div class="sb-filtros">
  <div class="sb-container">
    <div class="sb-filtros__inner">
      <button class="sb-filtro-btn active" data-filtro="todos">todos</button>
      <button class="sb-filtro-btn" data-filtro="iphone">iphone</button>
      <button class="sb-filtro-btn" data-filtro="mac">mac</button>
      <button class="sb-filtro-btn" data-filtro="ipad">ipad</button>
      <button class="sb-filtro-btn" data-filtro="acessorios">acessórios</button>
    </div>
  </div>
</div>

<section class="sb-section" style="padding-top: 0;">
  <div class="sb-container">
    <div class="sb-seminovos-grid" id="sb-grid">

      {% for block in section.blocks %}
        <div class="sb-card-produto" data-categoria="{{ block.settings.categoria }}" {{ block.shopify_attributes }}>
          <div class="sb-card-produto__img">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 600 | image_tag: alt: block.settings.title }}
            {% else %}
              <div style="display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--text-muted)">
                <svg width="32" height="32" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="1" y="1" width="38" height="38" rx="8" stroke="#4A4A60" stroke-width="1.5" stroke-dasharray="4 3"/>
                  <path d="M13 27l5-6 4 5 3-3 5 7H13z" stroke="#4A4A60" stroke-width="1.5" stroke-linejoin="round"/>
                  <circle cx="26" cy="15" r="3" stroke="#4A4A60" stroke-width="1.5"/>
                </svg>
                <span style="font-size:11px;letter-spacing:1px;text-transform:uppercase">foto</span>
              </div>
            {% endif %}
            <span class="sb-card-produto__estado">{{ block.settings.estado }}</span>
          </div>
          <div class="sb-card-produto__body">
            <div class="sb-card-produto__title">{{ block.settings.title }}</div>
            <div class="sb-card-produto__specs">{{ block.settings.specs }}</div>
            <div class="sb-card-produto__price">{{ block.settings.price }}</div>
          </div>
          <div class="sb-card-produto__footer">
            <a href="https://wa.me/{{ settings.whatsapp_number }}?text={{ block.settings.wa_message | url_encode }}" target="_blank" rel="noopener" class="sb-btn sb-btn--primary">
              tenho interesse
            </a>
          </div>
        </div>
      {% endfor %}

    </div>

    <div class="sb-empty" id="sb-empty" style="display: none;">
      <h3>nenhum produto nessa categoria</h3>
      <p>estoque atualizado frequentemente. fala com a gente pra saber o que está chegando.</p>
      <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" class="sb-btn sb-btn--primary" style="margin-top: 8px;">falar no whatsapp</a>
    </div>

  </div>
</section>

<section style="background: var(--surface-1); border-top: var(--border-subtle); padding: 80px 0; text-align: center;">
  <div class="sb-container">
    <p style="font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 16px;">não achou o que procura?</p>
    <h2 style="font-family: var(--font-display); font-size: clamp(28px, 4vw, 48px); font-weight: 800; margin-bottom: 12px;">fala com a gente.<br><span class="sb-blue">a gente resolve.</span></h2>
    <p style="color: var(--text-secondary); font-weight: 300; margin-bottom: 32px;">estoque atualiza constantemente. pode ser que o aparelho que você quer esteja chegando.</p>
    <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" class="sb-btn sb-btn--wa">abrir whatsapp</a>
  </div>
</section>

<script>
  (function () {
    var btns = document.querySelectorAll('.sb-filtro-btn');
    var cards = document.querySelectorAll('.sb-card-produto');
    var empty = document.getElementById('sb-empty');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var filtro = btn.dataset.filtro;
        var visible = 0;
        cards.forEach(function (card) {
          if (filtro === 'todos' || card.dataset.categoria === filtro) { card.style.display = ''; visible++; }
          else { card.style.display = 'none'; }
        });
        if (empty) empty.style.display = visible === 0 ? 'flex' : 'none';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Seminovos",
  "blocks": [
    {
      "type": "produto",
      "name": "Produto seminovo",
      "settings": [
        { "type": "text", "id": "title", "label": "Nome do produto", "default": "iPhone 15 Pro" },
        { "type": "text", "id": "specs", "label": "Especificações", "default": "256GB · preto titanium · sem caixa" },
        { "type": "text", "id": "price", "label": "Preço", "default": "R$ 0.000" },
        { "type": "select", "id": "estado", "label": "Estado", "options": [
          { "value": "perfeito", "label": "Perfeito" },
          { "value": "excelente", "label": "Excelente" },
          { "value": "bom", "label": "Bom" },
          { "value": "regular", "label": "Regular" }
        ], "default": "excelente" },
        { "type": "select", "id": "categoria", "label": "Categoria", "options": [
          { "value": "iphone", "label": "iPhone" },
          { "value": "mac", "label": "Mac" },
          { "value": "ipad", "label": "iPad" },
          { "value": "acessorios", "label": "Acessórios" }
        ], "default": "iphone" },
        { "type": "image_picker", "id": "image", "label": "Foto do produto" },
        { "type": "text", "id": "wa_message", "label": "Mensagem WhatsApp", "default": "Olá, tenho interesse no iPhone 15 Pro 256GB" }
      ]
    }
  ],
  "presets": [{ "name": "Seminovos" }]
}
{% endschema %}
