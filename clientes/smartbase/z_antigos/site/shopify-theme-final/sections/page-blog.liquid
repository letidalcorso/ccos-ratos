<style>
  .sb-page-hero { padding: 80px 0 64px; position: relative; }
  .sb-page-hero__bar { position: absolute; left: 0; top: 0; width: 4px; height: 100%; background: var(--blue-primary); }
  .sb-page-hero__content { position: relative; z-index: 1; max-width: 600px; display: flex; flex-direction: column; gap: 16px; }
  .sb-page-hero h1 { font-family: var(--font-display); font-size: clamp(36px, 5vw, 64px); font-weight: 800; line-height: 1.05; }
  .sb-page-hero__sub { font-size: 16px; font-weight: 300; color: var(--text-secondary); line-height: 1.8; }
  .sb-categorias { padding: 24px 0; border-bottom: var(--border-subtle); margin-bottom: 64px; }
  .sb-categorias__inner { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sb-cat-btn { padding: 8px 18px; border: var(--border-subtle); border-radius: var(--radius-pill); background: transparent; color: var(--text-secondary); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.15s ease; }
  .sb-cat-btn:hover, .sb-cat-btn.active { background: var(--blue-primary); border-color: var(--blue-primary); color: #fff; }
  .sb-blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; margin-bottom: 80px; }
  .sb-post-card { background: var(--surface-1); border: var(--border-subtle); border-radius: var(--radius-card-lg); overflow: hidden; transition: transform 0.2s ease, border-color 0.2s ease; display: flex; flex-direction: column; }
  .sb-post-card:hover { transform: translateY(-4px); border-color: var(--surface-3); }
  .sb-post-card__img { width: 100%; aspect-ratio: 16/9; background: var(--surface-2); display: flex; align-items: center; justify-content: center; border-bottom: var(--border-subtle); }
  .sb-post-card__img img { width: 100%; height: 100%; object-fit: cover; }
  .sb-post-card__body { padding: 24px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .sb-post-card__meta { display: flex; align-items: center; gap: 12px; }
  .sb-post-card__cat { display: inline-flex; padding: 3px 10px; background: var(--blue-alpha-10); border: 1px solid var(--blue-alpha-30); border-radius: var(--radius-badge); font-size: 10px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--blue-primary); }
  .sb-post-card__date { font-size: 11px; color: var(--text-muted); }
  .sb-post-card__title { font-family: var(--font-display); font-size: 18px; font-weight: 700; line-height: 1.3; }
  .sb-post-card__excerpt { font-size: 13px; font-weight: 300; color: var(--text-secondary); line-height: 1.7; flex: 1; }
  .sb-post-card__link { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--blue-primary); margin-top: 8px; transition: gap 0.15s ease; }
  .sb-post-card:hover .sb-post-card__link { gap: 10px; }
  @media (max-width: 640px) { .sb-blog-grid { grid-template-columns: 1fr; } }
</style>

<div class="sb-page-hero">
  <div class="sb-page-hero__bar"></div>
  <div class="sb-container">
    <div class="sb-page-hero__content">
      <span class="sb-badge">blog</span>
      <h1>o que você precisa<br><span class="sb-blue">saber sobre apple.</span></h1>
      <p class="sb-page-hero__sub">dicas, comparativos e novidades sobre produtos apple.</p>
    </div>
  </div>
</div>

<div class="sb-categorias">
  <div class="sb-container">
    <div class="sb-categorias__inner">
      <button class="sb-cat-btn active" data-cat="todos">todos</button>
      <button class="sb-cat-btn" data-cat="dicas">dicas</button>
      <button class="sb-cat-btn" data-cat="novidades">novidades</button>
      <button class="sb-cat-btn" data-cat="comparativos">comparativos</button>
      <button class="sb-cat-btn" data-cat="troca">troca</button>
    </div>
  </div>
</div>

<section style="padding: 0 0 80px;">
  <div class="sb-container">
    <div class="sb-blog-grid" id="sb-blog-grid">

      {% for block in section.blocks %}
        <article class="sb-post-card" data-cat="{{ block.settings.categoria }}" {{ block.shopify_attributes }}>
          <div class="sb-post-card__img">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.title }}
            {% else %}
              <div style="display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--text-muted)">
                <svg width="28" height="28" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="1" y="1" width="38" height="38" rx="8" stroke="#4A4A60" stroke-width="1.5" stroke-dasharray="4 3"/>
                  <path d="M13 27l5-6 4 5 3-3 5 7H13z" stroke="#4A4A60" stroke-width="1.5" stroke-linejoin="round"/>
                  <circle cx="26" cy="15" r="3" stroke="#4A4A60" stroke-width="1.5"/>
                </svg>
                <span style="font-size:11px;letter-spacing:1px;text-transform:uppercase">imagem do post</span>
              </div>
            {% endif %}
          </div>
          <div class="sb-post-card__body">
            <div class="sb-post-card__meta">
              <span class="sb-post-card__cat">{{ block.settings.categoria }}</span>
              <span class="sb-post-card__date">{{ block.settings.date }}</span>
            </div>
            <h2 class="sb-post-card__title">{{ block.settings.title }}</h2>
            <p class="sb-post-card__excerpt">{{ block.settings.excerpt }}</p>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="sb-post-card__link">ler artigo →</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}

    </div>
  </div>
</section>

<script>
  (function () {
    var btns = document.querySelectorAll('.sb-cat-btn');
    var cards = document.querySelectorAll('.sb-post-card');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var cat = btn.dataset.cat;
        cards.forEach(function (card) {
          card.style.display = (cat === 'todos' || card.dataset.cat === cat) ? '' : 'none';
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Blog",
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "excerpt", "label": "Resumo" },
        { "type": "select", "id": "categoria", "label": "Categoria", "options": [
          { "value": "dicas", "label": "Dicas" },
          { "value": "novidades", "label": "Novidades" },
          { "value": "comparativos", "label": "Comparativos" },
          { "value": "troca", "label": "Troca" }
        ], "default": "dicas" },
        { "type": "text", "id": "date", "label": "Data", "default": "abr 2026" },
        { "type": "image_picker", "id": "image", "label": "Imagem do post" },
        { "type": "url", "id": "link", "label": "Link do post completo" }
      ]
    }
  ],
  "presets": [{ "name": "Blog" }]
}
{% endschema %}
