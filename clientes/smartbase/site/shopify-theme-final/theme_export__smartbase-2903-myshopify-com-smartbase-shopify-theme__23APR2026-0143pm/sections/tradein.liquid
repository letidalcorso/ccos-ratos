<section id="tradein" class="sb-section sb-tradein">
  <div class="sb-tradein__bar"></div>
  <div class="sb-container">

    <div class="sb-tradein__header">
      <span class="sb-badge sb-badge--blue">{{ section.settings.badge }}</span>
      <h2>{{ section.settings.heading }} <span class="sb-blue">{{ section.settings.heading_blue }}</span></h2>
      <p class="sb-tradein__sub">{{ section.settings.subtitle }}</p>
    </div>

    <div class="sb-tradein__steps">
      {% for block in section.blocks %}
        <div class="sb-step-card" {{ block.shopify_attributes }}>
          <div class="sb-step-card__num">{{ forloop.index }}</div>
          <div class="sb-step-card__body">
            <div class="sb-step-card__title">{{ block.settings.title }}</div>
            <p class="sb-step-card__desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="sb-tradein__highlight">
      <div class="sb-tradein__highlight-text">{{ section.settings.highlight_text }}</div>
      <a href="{{ section.settings.cta_url }}" class="sb-btn sb-btn--primary">{{ section.settings.cta_text }}</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Aparelho como entrada",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "aparelho antigo como entrada"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "quer saber quanto"
    },
    {
      "type": "text",
      "id": "heading_blue",
      "label": "Título — parte azul",
      "default": "vale o seu?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "avaliação técnica real. sem achismo, sem pressão."
    },
    {
      "type": "textarea",
      "id": "highlight_text",
      "label": "Texto de destaque",
      "default": "retorno em até 1 hora. sem precisar ir até a loja pra saber o valor."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto do botão",
      "default": "avaliar meu aparelho"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link do botão"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Etapa",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título da etapa"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descrição"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aparelho como entrada",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "preencha o formulário",
            "description": "modelo, estado, capacidade e o que acompanha. leva menos de 2 minutos."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "receba a avaliação",
            "description": "a gente retorna em até 1 hora com o valor. sem tabela genérica, avaliação de verdade."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "aplique na troca",
            "description": "o valor do seu aparelho vira desconto na compra do próximo apple."
          }
        }
      ]
    }
  ]
}
{% endschema %}
