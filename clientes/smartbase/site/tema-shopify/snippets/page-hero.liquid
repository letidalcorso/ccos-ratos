{%- comment -%}
  Hero reutilizável de página (Vitrine/FAQ/Contato/Blog). Portado de Primitives.jsx (PageHero).
  Params: kicker, line1, line2 (azul), lead, sub, bg_image, bg_fallback, bg_id, bg_position, cta_label, cta_link.
{%- endcomment -%}
<section class="hm-hero page-hero rise">
  <div class="hm-hero-panel rise">
    <div class="ph-media">
      {% render 'img-slot', image: bg_image, fallback: bg_fallback, id: bg_id, cool: true, position: bg_position, label: 'imagem do hero (opcional)' %}
      <div class="ph-media-scrim"></div>
    </div>
    <div class="ph-brandrow">
      <span class="hm-pill-brand">smartbase</span>
      <span class="eyebrow pill ph-kicker">{{ kicker }}</span>
    </div>
    <div class="hm-hero-text ph-text">
      {%- if lead != blank -%}<div class="hm-hero-lead">{{ lead }}</div>{%- endif -%}
      <h2 class="headline" style="font-size:clamp(33px,5vw,72px);line-height:.98;letter-spacing:-1.5px">
        <span>{{ line1 }}</span>{% if line2 != blank %}<br><span class="b">{{ line2 }}</span>{% endif %}
      </h2>
      {%- if sub != blank -%}<p class="hero-glass-sub">{{ sub }}</p>{%- endif -%}
      {%- if cta_label != blank -%}
        <div class="hm-hero-ctas ph-ctas"><a class="btn btn-primary" href="{{ cta_link | default: '/' }}">{{ cta_label }} <span aria-hidden="true">→</span></a></div>
      {%- endif -%}
    </div>
  </div>
</section>
