{%- comment -%}
  Imagem editável nativa (<img>) — substitui o <image-slot> do protótipo.
  Lê o campo de imagem do painel; se vazio, cai no default (asset do tema);
  se não houver nenhum, mostra o placeholder de vidro.
  Params: image, fallback, id, class, fit (cover|contain), position, label, cool.
{%- endcomment -%}
{%- liquid
  assign src = ''
  if image != blank
    assign src = image | image_url: width: 1800
  elsif fallback != blank
    assign src = fallback | asset_url
  endif
  assign objfit = fit | default: 'cover'
  assign objpos = position | default: '50% 50%'
-%}
{%- if src != blank -%}
  <img{% if id != blank %} id="{{ id }}"{% endif %} class="sb-img {{ class }}"{% if cool %} data-cool{% endif %} src="{{ src }}" alt="{{ image.alt | default: label | escape }}" loading="lazy" style="object-fit:{{ objfit }};object-position:{{ objpos }}">
{%- else -%}
  <div{% if id != blank %} id="{{ id }}"{% endif %} class="sb-img slot {{ class }}" data-label="{{ label | escape }}"></div>
{%- endif -%}
