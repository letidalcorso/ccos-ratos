{%- comment -%}
  Template de página padrão (genérico). As páginas vitrine/faq/contato/blog
  têm templates próprios (page.vitrine.json, page.faq.json, etc.).
  Este aqui renderiza qualquer página comum: título + conteúdo do editor.
{%- endcomment -%}
<section class="page" style="padding:120px 0 96px">
  <h1 class="headline" style="font-size:clamp(32px,5vw,56px);margin:0 0 24px">{{ page.title }}</h1>
  <div class="sb-body rte">{{ page.content }}</div>
</section>
