{%- comment -%}
  Home · Vitrine embutida (showcase) — portado de HomePage.jsx (Showcase + HighlightsBand).
  Filtro #hmsLiquid mantido (estático, sem <animate> — animações ficam pra depois).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign highlights = section.blocks | where: 'type', 'highlight' -%}
{%- assign categories = section.blocks | where: 'type', 'category' -%}
<section class="hms-sec rise">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <filter id="hmsLiquid" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.009 0.013" numOctaves="2" seed="7" result="n"></feTurbulence>
      <feGaussianBlur in="n" stdDeviation="1.1" result="sn"></feGaussianBlur>
      <feDisplacementMap in="SourceGraphic" in2="sn" scale="34" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
  </svg>
  <div class="hms-stage">
    {% render 'img-slot', image: s.bg_image, fallback: 'amb-hero-store.png', id: 'home-vitrine-bg', class: 'hms-photo', fit: 'cover', label: 'foto da loja / ambiente' %}
    <div class="hms-veil" aria-hidden="true"></div>

    <div class="hms-stack">
      <div class="hms-title">
        <span class="hms-kicker">{{ s.kicker }}</span>
        <h2>{{ s.title_1 }} <span class="b">{{ s.title_2 }}</span></h2>
      </div>

      {%- if highlights.size > 0 -%}
        <div class="hms-hl-band-wrap{% if highlights.size >= 2 %} two{% endif %}">
          {%- for block in highlights -%}
            {%- liquid
              assign hl_target = ''
              if block.settings.dest == 'whatsapp'
                capture hl_href
                  render 'wa-link', produto: block.settings.name
                endcapture
                assign hl_target = '_blank'
              else
                assign hl_href = block.settings.url | default: '/collections/all'
              endif
            -%}
            <a class="hms-hl-band" href="{{ hl_href | strip }}"{% if hl_target != blank %} target="{{ hl_target }}" rel="noopener noreferrer"{% endif %} {{ block.shopify_attributes }}>
              <div class="hms-hl-band-media">{% render 'img-slot', image: block.settings.image, fallback: 'prod-iphone.png', class: 'hms-hl-band-img', fit: 'contain', label: 'foto do destaque' %}</div>
              <div class="hms-hl-band-copy">
                <span class="hms-hl-band-kick">{{ block.settings.kicker }}</span>
                <h3 class="hms-hl-band-t">{{ block.settings.name }}</h3>
                <p class="hms-hl-band-d">{{ block.settings.sub }}</p>
                {%- if block.settings.specs != blank -%}
                  <div class="hms-hl-band-meta">
                    {%- assign specs = block.settings.specs | split: ';' -%}
                    {%- for spec in specs -%}<span>{{ spec | strip }}</span>{%- endfor -%}
                  </div>
                {%- endif -%}
                <span class="hms-hl-band-cta">{{ block.settings.cta | default: 'quero esse' }} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="hms-win">
        <div class="hms-win-clip" aria-hidden="true"></div>
        <div class="hms-head">
          <span class="h">{{ s.win_title }}</span>
          <span class="s">{{ s.win_sub }}</span>
        </div>
        <div class="hms-grid">
          {%- for block in categories -%}
            <a class="hms-card" href="{{ block.settings.link | default: '/pages/vitrine' }}" {{ block.shopify_attributes }}>
              <div class="hms-pimg">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.label | escape }}" loading="lazy">
                {%- elsif block.settings.fallback != blank -%}
                  <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.label | escape }}" loading="lazy">
                {%- endif -%}
              </div>
              <div class="hms-pn">{{ block.settings.label }}</div>
              <div class="hms-pgo">{{ s.cat_cta | default: 'ver novos' }} →</div>
            </a>
          {%- endfor -%}
        </div>
      </div>

      <div class="hms-player">
        <div class="hms-pl-meta">
          <div class="t">{{ s.semi_title }}</div>
          <div class="s">{{ s.semi_sub }}</div>
        </div>
        <a class="hms-pl-cta" href="{{ s.semi_link | default: '/pages/vitrine?cond=seminovos' }}">{{ s.semi_cta }} <span class="ar" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home · Vitrine embutida",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Foto de fundo (loja / ambiente)" },
    { "type": "header", "content": "Título" },
    { "type": "text", "id": "kicker", "label": "Etiqueta", "default": "o que tem por aqui" },
    { "type": "text", "id": "title_1", "label": "Título (parte branca)", "default": "escolhe o seu." },
    { "type": "text", "id": "title_2", "label": "Título (parte azul)", "default": "a gente traz." },
    { "type": "header", "content": "Janela: novos" },
    { "type": "text", "id": "win_title", "label": "Rótulo", "default": "vitrine" },
    { "type": "text", "id": "win_sub", "label": "Subtítulo", "default": "novos · escolhe a categoria" },
    { "type": "text", "id": "cat_cta", "label": "Texto do link nos cards", "default": "ver novos" },
    { "type": "header", "content": "Barra: seminovos" },
    { "type": "text", "id": "semi_title", "label": "Título", "default": "seminovos" },
    { "type": "text", "id": "semi_sub", "label": "Subtítulo", "default": "outro dono, mesma Apple. vê o que chegou." },
    { "type": "text", "id": "semi_cta", "label": "Botão — texto", "default": "ver seminovos" },
    { "type": "url", "id": "semi_link", "label": "Botão — link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria (card)",
      "settings": [
        { "type": "text", "id": "label", "label": "Nome", "default": "categoria" },
        { "type": "image_picker", "id": "image", "label": "Foto do produto" },
        { "type": "text", "id": "fallback", "label": "Imagem padrão (asset)", "info": "Nome do arquivo em assets/. Ex.: prod-iphone.png" },
        { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" }
      ]
    },
    {
      "type": "highlight",
      "name": "Destaque",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Etiqueta", "default": "lançamento" },
        { "type": "text", "id": "name", "label": "Produto", "default": "iPhone 17 Pro" },
        { "type": "textarea", "id": "sub", "label": "Texto", "default": "o topo da linha, lacrado e sob encomenda. chega em até 7 dias." },
        { "type": "text", "id": "specs", "label": "Specs (separe com ;)", "default": "256GB · 512GB · 1TB ; cosmic orange ; garantia apple · 12 meses" },
        { "type": "image_picker", "id": "image", "label": "Foto do destaque" },
        { "type": "select", "id": "dest", "label": "Botão vai para", "options": [ { "value": "whatsapp", "label": "WhatsApp" }, { "value": "link", "label": "Link próprio" } ], "default": "whatsapp" },
        { "type": "url", "id": "url", "label": "Link (se 'Link próprio')" },
        { "type": "text", "id": "cta", "label": "Texto do botão", "default": "quero esse" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Home · Vitrine embutida",
      "blocks": [
        { "type": "category", "settings": { "label": "mac", "fallback": "prod-mac.png", "link": "/collections/all" } },
        { "type": "category", "settings": { "label": "ipad", "fallback": "prod-ipad.png", "link": "/collections/all" } },
        { "type": "category", "settings": { "label": "iphone", "fallback": "prod-iphone.png", "link": "/collections/all" } },
        { "type": "category", "settings": { "label": "watch", "fallback": "prod-watch.png", "link": "/collections/all" } },
        { "type": "category", "settings": { "label": "airpods", "fallback": "prod-airpods.png", "link": "/collections/all" } },
        { "type": "category", "settings": { "label": "acessórios", "fallback": "prod-acessorios.png", "link": "/collections/all" } }
      ]
    }
  ]
}
{% endschema %}
