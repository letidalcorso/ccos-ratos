{%- comment -%} Contato — portado de MorePages.jsx (ContatoPage). {%- endcomment -%}
{%- assign s = section.settings -%}
<div class="contato-page">
  {% render 'page-hero',
    kicker: s.hero_kicker, line1: s.hero_line1, line2: s.hero_line2, sub: s.hero_sub,
    bg_image: s.hero_image, bg_fallback: 'amb-hero-contato.jpg', bg_id: 'contato-hero', bg_position: '50% 60%',
    cta_label: s.hero_cta, cta_link: '#ct-body' %}

  <section class="page ct-body rise" id="ct-body">
    {%- liquid
      assign coords = s.map_coords | default: '-29.16877,-51.17984'
      assign cparts = coords | split: ','
      assign lat = cparts[0] | strip
      assign lng = cparts[1] | strip
    -%}
    <a class="ct-map" href="https://waze.com/ul?ll={{ lat }},{{ lng }}&navigate=yes" target="_blank" rel="noopener noreferrer" aria-label="abrir rota no Waze">
      {%- if s.map_image != blank -%}
        <img class="ct-map-img" src="{{ s.map_image | image_url: width: 1200 }}" alt="mapa — {{ s.map_local | escape }}" loading="lazy">
      {%- else -%}
        <img class="ct-map-img" src="{{ 'map-loja.png' | asset_url }}" alt="mapa — {{ s.map_local | escape }}" loading="lazy">
      {%- endif -%}
      <span class="ct-map-scrim" aria-hidden="true"></span>
      <span class="ct-map-cta">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2a8 8 0 0 0-8 8c0 5.4 8 12 8 12s8-6.6 8-12a8 8 0 0 0-8-8zm0 5a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/></svg>
        traçar rota no Waze <span aria-hidden="true">→</span>
      </span>
      <span class="ct-map-tag">⚲ {{ s.map_local }} · <span class="ct-warn">{{ s.map_warn }}</span></span>
    </a>
    <div class="ct-info">
      <div class="ct-card">
        <div class="ct-k">endereço</div>
        <div class="ct-v ct-warn">{{ s.endereco }}</div>
      </div>
      <div class="ct-card">
        <div class="ct-k">horário</div>
        <div class="ct-v">{{ s.horario }}</div>
        {%- if s.horario_note != blank -%}<div class="ct-note">{{ s.horario_note }}</div>{%- endif -%}
      </div>
      <div class="ct-card">
        <div class="ct-k">atendimento</div>
        <div class="ct-v">{{ s.atendimento }}</div>
      </div>
    </div>
  </section>
</div>

<style>
  .ct-map{display:block;position:relative;min-height:420px;overflow:hidden;text-decoration:none;cursor:pointer}
  .ct-map-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  .ct-map-scrim{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(7,7,14,.10),rgba(7,7,14,.5))}
  .ct-map-cta{position:absolute;z-index:4;right:14px;top:14px;display:inline-flex;align-items:center;gap:8px;
    padding:10px 15px;border-radius:999px;font-weight:600;font-size:14px;color:#fff;
    background:rgba(10,10,18,.78);border:1px solid rgba(255,255,255,.2);
    -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);transition:background .2s,border-color .2s}
  .ct-map:hover .ct-map-cta{background:var(--sb-signal,#3E82F7);border-color:transparent}
  .ct-map-tag{z-index:4}
</style>

{% schema %}
{
  "name": "Contato",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_kicker", "label": "Etiqueta", "default": "contato" },
    { "type": "text", "id": "hero_line1", "label": "Título — linha 1", "default": "passa na loja." },
    { "type": "text", "id": "hero_line2", "label": "Título — linha 2 (azul)", "default": "a gente te espera." },
    { "type": "textarea", "id": "hero_sub", "label": "Texto de apoio", "default": "tem loja de verdade em caxias do sul, de portas abertas pra você. vem conhecer, tomar um café e ver os aparelhos de perto. ou fala com a gente no WhatsApp, de onde você estiver." },
    { "type": "image_picker", "id": "hero_image", "label": "Foto de fundo do hero" },
    { "type": "text", "id": "hero_cta", "label": "Botão do hero", "default": "quero conhecer a loja" },
    { "type": "header", "content": "Mapa" },
    { "type": "text", "id": "map_local", "label": "Local (no mapa)", "default": "caxias do sul" },
    { "type": "text", "id": "map_warn", "label": "Aviso (no mapa, em cinza)", "default": "endereço completo no WhatsApp" },
    { "type": "image_picker", "id": "map_image", "label": "Imagem do mapa (sua print)", "info": "Suba uma print do Google Maps/Waze da loja. Vazio = mapa padrão." },
    { "type": "text", "id": "map_coords", "label": "Coordenadas (lat,long) — pro botão do Waze", "info": "Rota do Waze. Pega no Google Maps: clica no ponto e copia os números. Ex.: -29.16877,-51.17984", "default": "-29.16877,-51.17984" },
    { "type": "header", "content": "Cards" },
    { "type": "textarea", "id": "endereco", "label": "Endereço", "default": "loja em caxias do sul, rs\nendereço completo a gente passa no WhatsApp" },
    { "type": "textarea", "id": "horario", "label": "Horário", "default": "seg–sex · 9h às 19h\nsáb · 9h às 13h\ndomingo · fechado" },
    { "type": "text", "id": "horario_note", "label": "Observação do horário", "default": "excepcionalmente atendemos fora desses horários — combina no whatsapp." },
    { "type": "textarea", "id": "atendimento", "label": "Atendimento", "default": "WhatsApp · +55 54 99662-4494\ncaxias e serra gaúcha" }
  ],
  "presets": [{ "name": "Contato" }]
}
{% endschema %}
