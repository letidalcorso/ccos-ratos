{%- comment -%} Vitrine — portado de VitrinePage.jsx. Filtro client-side (vitrine.js). {%- endcomment -%}
{%- assign s = section.settings -%}
<div class="vitrine-page">

  {% render 'page-hero',
    kicker: s.hero_kicker,
    line1: s.hero_line1,
    line2: s.hero_line2,
    sub: s.hero_sub,
    bg_image: s.hero_image,
    bg_fallback: 'amb-hero-store.jpg',
    bg_id: 'vitrine-hero-bg',
    bg_position: '50% 50%' %}

  <section class="page vt-portas rise">
    <article class="porta rise">
      <div class="porta-main">
        <h3 class="porta-title">{{ s.porta_novos_title }}</h3>
        <div class="porta-sub">{{ s.porta_novos_sub }}</div>
        {%- if s.porta_novos_note != blank -%}<p class="porta-note">{{ s.porta_novos_note }}</p>{%- endif -%}
      </div>
      <div class="porta-gar">
        <span class="eyebrow signal">garantia</span>
        <div class="porta-gar-v">{{ s.porta_novos_garantia }}</div>
      </div>
    </article>
    <article class="porta rise">
      <div class="porta-main">
        <h3 class="porta-title">{{ s.porta_semi_title }}</h3>
        <div class="porta-sub">{{ s.porta_semi_sub }}</div>
        {%- if s.porta_semi_note != blank -%}<p class="porta-note">{{ s.porta_semi_note }}</p>{%- endif -%}
      </div>
      <div class="porta-gar">
        <span class="eyebrow signal">garantia</span>
        <div class="porta-gar-v">{{ s.porta_semi_garantia }}</div>
      </div>
    </article>
  </section>

  <div class="vt-chips-wrap">
    <div class="vt-bar">
      <div class="vt-seg" role="tablist" aria-label="condição">
        <span class="vt-seg-b on" data-cond="tudo">tudo</span>
        <span class="vt-seg-b" data-cond="novos">novos</span>
        <span class="vt-seg-b" data-cond="seminovos">seminovos</span>
      </div>
      <span class="vt-bar-div" aria-hidden="true"></span>
      <div class="vt-chips">
        <span class="vt-chip on" data-cat="todos">todos</span>
        <span class="vt-chip" data-cat="iphone">iPhone</span>
        <span class="vt-chip" data-cat="mac">Mac</span>
        <span class="vt-chip" data-cat="ipad">iPad</span>
        <span class="vt-chip" data-cat="watch">Watch</span>
        <span class="vt-chip" data-cat="airpods">AirPods</span>
        <span class="vt-chip" data-cat="acessorios">Acessórios</span>
      </div>
    </div>
  </div>

  <section class="page vt-list rise">
    {%- assign cat_keys = 'iphone,mac,ipad,watch,airpods,acessorios' | split: ',' -%}
    {%- assign cat_names = 'iPhone,Mac,iPad,Apple Watch,AirPods,Acessórios' | split: ',' -%}
    {%- for i in (0..5) -%}
      {%- assign ckey = cat_keys[i] -%}
      {%- assign count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'produto' and block.settings.cat == ckey -%}{%- assign count = count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if count > 0 -%}
        <div class="vt-cat-head" data-cat-head="{{ ckey }}">
          <span class="eyebrow signal">{{ cat_names[i] }}</span>
          <span class="vt-cat-rule"></span>
          <span class="vt-cat-n">{{ count }} modelos</span>
        </div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'produto' and block.settings.cat == ckey -%}
            {% render 'product-card', block: block %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}

    <div class="vt-empty" hidden>
      <div class="vt-empty-t">nada aqui nessa categoria ainda.</div>
      <p class="vt-empty-s">mas se existe, a gente acha. me diz o que você procura.</p>
      <a class="btn btn-primary btn-sm" href="{% render 'wa-link', texto: 'oi! tava na vitrine do site e não achei o que procuro, me ajuda?' %}" target="_blank" rel="noopener noreferrer">vou chamar no whatsapp <span aria-hidden="true">→</span></a>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Vitrine",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_kicker", "label": "Etiqueta", "default": "vitrine" },
    { "type": "text", "id": "hero_line1", "label": "Título — linha 1", "default": "o seu próximo" },
    { "type": "text", "id": "hero_line2", "label": "Título — linha 2 (azul)", "default": "está aqui." },
    { "type": "textarea", "id": "hero_sub", "label": "Texto de apoio", "default": "a Apple inteira, particular sua. lacrada ou seminova, sempre com garantia. você só paga quando ela tá na sua mão." },
    { "type": "image_picker", "id": "hero_image", "label": "Foto de fundo do hero" },
    { "type": "header", "content": "Porta: novos" },
    { "type": "text", "id": "porta_novos_title", "label": "Título", "default": "novos" },
    { "type": "text", "id": "porta_novos_sub", "label": "Subtítulo", "default": "lacrados. sob encomenda." },
    { "type": "textarea", "id": "porta_novos_note", "label": "Texto", "default": "a gente encomenda lacrado direto pra você. sem estoque parado. chega em até 7 dias, com nota e garantia Apple." },
    { "type": "text", "id": "porta_novos_garantia", "label": "Garantia", "default": "apple oficial · 12 meses" },
    { "type": "header", "content": "Porta: seminovos" },
    { "type": "text", "id": "porta_semi_title", "label": "Título", "default": "seminovos" },
    { "type": "text", "id": "porta_semi_sub", "label": "Subtítulo", "default": "em estoque agora. conferidos um a um." },
    { "type": "textarea", "id": "porta_semi_note", "label": "Texto", "default": "cada seminovo passa por checagem completa: bateria, tela, câmeras e originalidade. fotos reais do aparelho que você vai receber, com garantia smartbase." },
    { "type": "text", "id": "porta_semi_garantia", "label": "Garantia", "default": "smartbase · 3 meses" }
  ],
  "blocks": [
    {
      "type": "produto",
      "name": "Produto",
      "settings": [
        { "type": "select", "id": "cat", "label": "Categoria", "options": [
          { "value": "iphone", "label": "iPhone" },
          { "value": "mac", "label": "Mac" },
          { "value": "ipad", "label": "iPad" },
          { "value": "watch", "label": "Apple Watch" },
          { "value": "airpods", "label": "AirPods" },
          { "value": "acessorios", "label": "Acessórios" }
        ], "default": "iphone" },
        { "type": "text", "id": "name", "label": "Nome", "default": "Produto Apple" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "fallback", "label": "Imagem padrão (asset)", "info": "Nome do arquivo em assets/. Ex.: prod-iphone.webp" },
        { "type": "textarea", "id": "desc", "label": "Descrição" },
        { "type": "text", "id": "specs", "label": "Specs (separe com ;)" },
        { "type": "text", "id": "colors", "label": "Cores (nome:#hex separados por ;)", "info": "Ex.: cosmic orange:#c2622f; navy:#26344c" },
        { "type": "select", "id": "cond", "label": "Condição", "options": [
          { "value": "novo", "label": "Novo · lacrado (sob encomenda)" },
          { "value": "seminovo", "label": "Seminovo · conferido (em estoque)" }
        ], "default": "novo" },
        { "type": "checkbox", "id": "in_stock", "label": "Disponível (bolinha verde)", "default": true },
        { "type": "text", "id": "price", "label": "Preço (vazio = sob consulta)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "produto", "settings": { "cat": "iphone", "name": "iPhone 17 Pro Max", "fallback": "prod-iphone-17-pro-max.webp", "desc": "o topo da linha. câmera, tela e bateria no máximo. sem concessão.", "specs": "256GB · 512GB · 1TB · 2TB", "colors": "cosmic orange:#c2622f; navy:#26344c; silver:#d7d9db", "cond": "novo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "iphone", "name": "iPhone 17", "fallback": "prod-iphone-17.webp", "desc": "o iphone pra todo dia. cinco cores e a câmera que importa.", "specs": "256GB · 512GB", "colors": "azul:#cadcef; branco:#ededf0; sálvia:#c7d2bd; lavanda:#d7cfe6; rosa:#efd7dd", "cond": "seminovo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "iphone", "name": "iPhone Air", "fallback": "prod-iphone-air.webp", "desc": "o mais fino e leve. Apple sem peso na mão.", "specs": "256GB · 512GB", "colors": "preto-espacial:#2b2b2d; branco-nuvem:#e8e8ea; dourado:#e4dcc6; azul-céu:#bccadc", "cond": "novo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "mac", "name": "MacBook Air", "fallback": "prod-macbook-air.webp", "desc": "leve, silencioso e o dia inteiro de bateria. o mac do dia a dia.", "specs": "M4 · 13\" e 15\"; 16GB · 512GB", "colors": "meia-noite:#2e3641; estelar:#efe6d6; prata:#dcdee0; azul-céu:#b6c8de", "cond": "novo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "mac", "name": "MacBook Pro", "fallback": "prod-macbook.webp", "desc": "potência pra trabalho pesado. tela que impressiona, bateria que aguenta.", "specs": "M4 Pro · 14\" e 16\"; 18GB · 512GB+", "colors": "", "cond": "novo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "mac", "name": "Mac mini", "fallback": "prod-mac-mini.webp", "desc": "o mac que cabe na palma. potência de desktop num corpo mínimo.", "specs": "M4 · M4 Pro; 16GB · 256GB+", "colors": "", "cond": "seminovo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "ipad", "name": "iPad Pro", "fallback": "prod-ipad-pro.webp", "desc": "tela pra criar, ler e ver tudo. com a pegada de um computador.", "specs": "11\" · 13\"; M4 · 256GB+", "colors": "preto-espacial:#2b2b2d; prata:#dcdee0", "cond": "novo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "ipad", "name": "iPad Air", "fallback": "prod-ipad-air.webp", "desc": "leve e poderoso. pro dia a dia que rende sem pesar.", "specs": "11\" · 13\"; M3 · 128GB+", "colors": "azul:#aebfe0; roxo:#c5b6e0; estelar:#e8e0d0; cinza-espacial:#3a3c40", "cond": "seminovo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "ipad", "name": "iPad", "fallback": "prod-ipad.webp", "desc": "o ipad essencial. colorido, simples, pra todo mundo.", "specs": "10,9\"; A16 · 128GB+", "colors": "azul:#9cb4d6; rosa:#eccdd0; amarelo:#ecdf9e; prata:#dcdee0", "cond": "seminovo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "watch", "name": "Apple Watch Ultra", "fallback": "prod-watch-ultra.webp", "desc": "feito pra ir além. bateria de sobra, GPS preciso e resistência de verdade.", "specs": "49mm · titânio; GPS + Cellular", "colors": "", "cond": "novo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "watch", "name": "Apple Watch Series 11", "fallback": "prod-watch-series.webp", "desc": "saúde, treino e notificações no pulso. o dia todo, sem pensar.", "specs": "42 · 46mm; GPS · Cellular", "colors": "", "cond": "seminovo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "watch", "name": "Apple Watch SE", "fallback": "prod-watch-se.webp", "desc": "o essencial do watch, com o preço que cabe. pra começar bem.", "specs": "40 · 44mm; GPS", "colors": "", "cond": "seminovo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "airpods", "name": "AirPods Pro 3", "fallback": "prod-airpods-pro.webp", "desc": "cancelamento de ruído que muda o seu dia. som que te envolve.", "specs": "USB-C; estojo MagSafe", "colors": "", "cond": "novo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "airpods", "name": "AirPods 4", "fallback": "prod-airpods-4.webp", "desc": "o som sem fio da Apple, leve e prático. com ou sem cancelamento.", "specs": "USB-C; com / sem ANC", "colors": "", "cond": "seminovo", "in_stock": true } },
      { "type": "produto", "settings": { "cat": "airpods", "name": "AirPods Max", "fallback": "prod-airpods-max.webp", "desc": "som over-ear que isola o mundo. acabamento em alumínio.", "specs": "USB-C; áudio espacial", "colors": "", "cond": "novo", "in_stock": true } }
    ]
  }
}
{% endschema %}
