<section class="page sb-placeholder">
  <div class="eyebrow signal">{{ section.settings.eyebrow }}</div>
  <h1 class="headline">{{ section.settings.title }}</h1>
  <p class="sb-lead">{{ section.settings.text }}</p>
</section>

{% schema %}
{
  "name": "Placeholder (home)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "em construção" },
    { "type": "text", "id": "title", "label": "Título", "default": "o tema tá nascendo." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "esqueleto pronto — header, rodapé e identidade no ar. as seções da home entram na próxima etapa." }
  ],
  "presets": [{ "name": "Placeholder (home)" }]
}
{% endschema %}
