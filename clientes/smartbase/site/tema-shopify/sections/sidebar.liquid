{%- comment -%}
  Sidebar — trilho vertical de vidro fixo na esquerda, só ícones + tooltip no hover.
  Página atual destacada (.on). Portado do Primitives.jsx (componente Sidebar).
  No mobile vira barra flutuante embaixo (regra já em kit.css).
{%- endcomment -%}
<nav class="sidebar" aria-label="navegação do site">
  {%- for block in section.blocks -%}
    {%- liquid
      assign on = false
      if block.settings.match == 'index' and request.page_type == 'index'
        assign on = true
      elsif block.settings.match != blank and block.settings.match != 'index' and request.path contains block.settings.match
        assign on = true
      endif
    -%}
    <a class="nav-ic{% if on %} on{% endif %}" href="{{ block.settings.link }}" aria-label="{{ block.settings.label | escape }}"{% if on %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>
      {% render 'nav-icon', icon: block.settings.icon %}
      <span class="nav-tip">{{ block.settings.label }}</span>
    </a>
  {%- endfor -%}
</nav>

{% schema %}
{
  "name": "Sidebar (navegação)",
  "max_blocks": 7,
  "blocks": [
    {
      "type": "item",
      "name": "Item de menu",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "home", "label": "Início (casa)" },
            { "value": "bag", "label": "Vitrine (sacola)" },
            { "value": "help", "label": "FAQ (interrogação)" },
            { "value": "chat", "label": "Contato (balão)" },
            { "value": "doc", "label": "Blog (documento)" },
            { "value": "user", "label": "Pessoa" }
          ],
          "default": "home"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Nome (aparece ao passar o mouse)",
          "default": "início"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link de destino"
        },
        {
          "type": "text",
          "id": "match",
          "label": "Destacar quando a URL contém",
          "info": "Use 'index' para a home. Ex.: /pages/faq, /collections, /blogs"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "icon": "home", "label": "início", "link": "/", "match": "index" } },
      { "type": "item", "settings": { "icon": "bag", "label": "vitrine", "link": "/collections/all", "match": "/collections" } },
      { "type": "item", "settings": { "icon": "help", "label": "faq", "link": "/pages/faq", "match": "/pages/faq" } },
      { "type": "item", "settings": { "icon": "chat", "label": "contato", "link": "/pages/contato", "match": "/pages/contato" } },
      { "type": "item", "settings": { "icon": "doc", "label": "blog", "link": "/blogs/news", "match": "/blogs" } }
    ]
  }
}
{% endschema %}
