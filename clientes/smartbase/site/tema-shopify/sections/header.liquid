{%- liquid
  assign menu = section.settings.menu
-%}
<header class="sb-header{% if section.settings.sticky %} sb-header--sticky{% endif %}" role="banner">
  <div class="page sb-header-inner">
    <a href="{{ routes.root_url }}" class="logo sm sb-logo" aria-label="{{ shop.name | escape }} — início">
      <span class="mark"><i></i></span>
      <span class="word">smart<b>base</b></span>
    </a>

    <nav class="sb-nav" aria-label="navegação principal">
      {%- for link in menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="sb-header-actions">
      {%- if section.settings.show_wa -%}
        <a class="btn btn-glass btn-sm sb-header-cta" href="{% render 'wa-link' %}" target="_blank" rel="noopener">
          {{ section.settings.wa_label | default: 'whatsapp' }} <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
      <button class="sb-burger" type="button" aria-label="abrir menu" aria-expanded="false" aria-controls="sb-drawer" data-sb-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="sb-drawer" id="sb-drawer" data-sb-drawer hidden>
    <nav class="sb-drawer-nav" aria-label="menu">
      {%- for link in menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
      {%- if section.settings.show_wa -%}
        <a class="btn btn-primary sb-drawer-cta" href="{% render 'wa-link' %}" target="_blank" rel="noopener">
          {{ section.settings.wa_label_mobile | default: 'falar no whatsapp' }} <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Crie/edite o menu em Conteúdo → Menus no painel."
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Fixar cabeçalho ao rolar",
      "default": true
    },
    {
      "type": "header",
      "content": "Botão WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "show_wa",
      "label": "Mostrar botão de WhatsApp",
      "default": true
    },
    {
      "type": "text",
      "id": "wa_label",
      "label": "Texto do botão (desktop)",
      "default": "whatsapp"
    },
    {
      "type": "text",
      "id": "wa_label_mobile",
      "label": "Texto do botão (menu mobile)",
      "default": "falar no whatsapp"
    }
  ]
}
{% endschema %}
