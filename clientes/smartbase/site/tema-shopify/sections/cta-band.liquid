{%- comment -%}
  Faixa pré-rodapé — portado de App.jsx (CtaBand). Global (renderizada no layout).
  Mostra a copy própria da página atual (home / vitrine / faq / contato / blog).
  Cada página tem: liga-desliga, texto, botão e destino próprios (whatsapp / vitrine / link).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- liquid
  # qual página estamos vendo
  assign p = 'h'
  if request.page_type == 'index'
    assign p = 'h'
  elsif request.page_type == 'blog' or request.page_type == 'article'
    assign p = 'b'
  elsif page.handle == 'vitrine'
    assign p = 'v'
  elsif page.handle == 'faq'
    assign p = 'f'
  elsif page.handle == 'contato'
    assign p = 'c'
  elsif page.handle == 'blog'
    assign p = 'b'
  else
    assign p = 'h'
  endif

  # mensagem do WhatsApp por página (vai pré-preenchida + sinaliza a origem do lead)
  assign wa_msg = 'oi! vim pelo site, quero saber dos aparelhos'
  if p == 'v'
    assign wa_msg = 'oi! tava vendo a vitrine no site e queria uma ajuda pra escolher'
  elsif p == 'f'
    assign wa_msg = 'oi! vi o site de vocês e fiquei com uma dúvida'
  elsif p == 'c'
    assign wa_msg = 'oi! vim pela página de contato do site, queria falar com vocês'
  elsif p == 'b'
    assign wa_msg = 'oi! vim pelo site de vocês, quero saber dos aparelhos'
  endif
-%}
{%- capture wa -%}{% render 'wa-link', texto: wa_msg %}{%- endcapture -%}
{%- liquid
  # puxa os campos do grupo certo (acesso dinâmico pelo prefixo)
  assign id_show = p | append: '_show'
  assign id_eyebrow = p | append: '_eyebrow'
  assign id_h1 = p | append: '_h1'
  assign id_h2 = p | append: '_h2'
  assign id_sub = p | append: '_sub'
  assign id_cta = p | append: '_cta'
  assign id_dest = p | append: '_dest'
  assign id_link = p | append: '_link'

  assign id_b2label = p | append: '_btn2_label'
  assign id_b2url = p | append: '_btn2_url'
  assign id_b2blank = p | append: '_btn2_blank'

  assign show = s[id_show]
  assign eyebrow = s[id_eyebrow]
  assign h1 = s[id_h1]
  assign h2 = s[id_h2]
  assign sub = s[id_sub]
  assign cta = s[id_cta]
  assign dest = s[id_dest]
  assign link = s[id_link]
  assign btn2_label = s[id_b2label]
  assign btn2_url = s[id_b2url]
  assign btn2_blank = s[id_b2blank]

  # destino do botão principal
  assign href = '/'
  assign blank = false
  if dest == 'whatsapp'
    assign href = wa
    assign blank = true
  elsif dest == 'vitrine'
    assign href = '/pages/vitrine'
  elsif dest == 'link'
    assign href = link
  endif

  # botão 2 (secundário) — aparece só quando tem rótulo. Vitrine cai no FAQ por padrão.
  assign btn2_href = btn2_url
  if btn2_href == blank
    if p == 'v'
      assign btn2_href = '/pages/faq'
    else
      assign btn2_href = '#'
    endif
  endif
-%}
{%- if show and request.page_type != 'article' -%}
<section class="cta-band rise">
  {%- if s.show_glow -%}<div class="cta-band-glow"></div>{%- endif -%}
  <div class="cta-band-copy">
    {%- if eyebrow != blank -%}<div class="eyebrow signal cta-band-eyebrow">{{ eyebrow }}</div>{%- endif -%}
    <h2 class="headline cta-band-h" style="font-size:clamp(24px,3.6vw,52px);line-height:.98;letter-spacing:-1.2px">
      <span>{{ h1 }}</span>{% if h2 != blank %} <span class="b">{{ h2 }}</span>{% endif %}
    </h2>
    {%- if sub != blank -%}<p class="cta-band-sub">{{ sub }}</p>{%- endif -%}
  </div>
  <div class="cta-band-actions">
    <a class="btn btn-primary" href="{{ href | default: '/' }}"{% if blank %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ cta }} <span aria-hidden="true">→</span></a>
    {%- if btn2_label != blank -%}
      <a class="btn btn-glass" href="{{ btn2_href | default: '#' }}"{% if btn2_blank %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ btn2_label }} <span aria-hidden="true">→</span></a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

