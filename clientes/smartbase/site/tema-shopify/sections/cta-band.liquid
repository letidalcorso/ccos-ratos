    { "type": "checkbox", "id": "f_show", "label": "Mostrar faixa no FAQ", "default": true },
    { "type": "text", "id": "f_eyebrow", "label": "Etiqueta", "default": "tirou as dúvidas?" },
    { "type": "text", "id": "f_h1", "label": "Título — parte 1", "default": "então bora" },
    { "type": "text", "id": "f_h2", "label": "Título — parte 2 (azul)", "default": "escolher o teu." },
    { "type": "textarea", "id": "f_sub", "label": "Texto", "default": "ainda com alguma pergunta? chama no whatsapp que a gente te ajuda a decidir." },
    { "type": "text", "id": "f_cta", "label": "Botão — texto", "default": "vou escolher meu aparelho" },
    { "type": "select", "id": "f_dest", "label": "Botão — destino", "options": [ { "value": "whatsapp", "label": "WhatsApp" }, { "value": "vitrine", "label": "Vitrine" }, { "value": "link", "label": "Link próprio" } ], "default": "vitrine" },
    { "type": "url", "id": "f_link", "label": "Link próprio (se destino = Link próprio)" },

    { "type": "header", "content": "Contato" },
    { "type": "checkbox", "id": "c_show", "label": "Mostrar faixa no contato", "default": true },
    { "type": "text", "id": "c_eyebrow", "label": "Etiqueta", "default": "bora conversar?" },
    { "type": "text", "id": "c_h1", "label": "Título — parte 1", "default": "a gente tá" },
    { "type": "text", "id": "c_h2", "label": "Título — parte 2 (azul)", "default": "a uma mensagem de distância." },
