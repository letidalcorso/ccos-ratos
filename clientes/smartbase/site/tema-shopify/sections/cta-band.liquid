{%- comment -%}
  Faixa pré-rodapé — portado de App.jsx (CtaBand). Global (renderizada no layout).
  Mostra a copy própria da página atual (home / vitrine / faq / contato / blog).
  Cada página tem: liga-desliga, texto, botão e destino próprios (whatsapp / vitrine / link).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- capture wa -%}{% render 'wa-link' %}{%- endcapture -%}
{%- liquid
  # qual página estamos vendo
  assign p = 'h'
  if request.page_type == 'index'
    assign p = 'h'
  elsif page.handle == 'vitrine'
    assign p = 'v'
  elsif page.handle == 'faq'
    assign p = 'f'
  elsif page.handle == 'contato'
    assign p = 'c'
  elsif page.handle == 'blog'
    assign p = 'b'
  else
    assign p = 'h'
  endif

  # puxa os campos do grupo certo (acesso dinâmico pelo prefixo)
  assign id_show = p | append: '_show'
  assign id_eyebrow = p | append: '_eyebrow'
  assign id_h1 = p | append: '_h1'
  assign id_h2 = p | append: '_h2'
  assign id_sub = p | append: '_sub'
  assign id_cta = p | append: '_cta'
  assign id_dest = p | append: '_dest'
  assign id_link = p | append: '_link'

  assign show = s[id_show]
  assign eyebrow = s[id_eyebrow]
  assign h1 = s[id_h1]
  assign h2 = s[id_h2]
  assign sub = s[id_sub]
  assign cta = s[id_cta]
  assign dest = s[id_dest]
  assign link = s[id_link]

  # destino do botão
  assign href = '/'
  assign blank = false
  if dest == 'whatsapp'
    assign href = wa
    assign blank = true
  elsif dest == 'vitrine'
    assign href = '/pages/vitrine'
  elsif dest == 'link'
    assign href = link
  endif
-%}
{%- if show -%}
<section class="cta-band rise">
  {%- if s.show_glow -%}<div class="cta-band-glow"></div>{%- endif -%}
  <div class="cta-band-copy">
    {%- if eyebrow != blank -%}<div class="eyebrow signal cta-band-eyebrow">{{ eyebrow }}</div>{%- endif -%}
    <h2 class="headline cta-band-h" style="font-size:clamp(24px,3.6vw,52px);line-height:.98;letter-spacing:-1.2px">
      <span>{{ h1 }}</span>{% if h2 != blank %} <span class="b">{{ h2 }}</span>{% endif %}
    </h2>
    {%- if sub != blank -%}<p class="cta-band-sub">{{ sub }}</p>{%- endif -%}
  </div>
  <div class="cta-band-actions">
    <a class="btn btn-primary" href="{{ href | default: '/' }}"{% if blank %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ cta }} <span aria-hidden="true">→</span></a>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Faixa pré-rodapé",
  "settings": [
    { "type": "checkbox", "id": "show_glow", "label": "Mostrar brilho de fundo", "default": true },

    { "type": "header", "content": "Home" },
    { "type": "checkbox", "id": "h_show", "label": "Mostrar faixa na home", "default": true },
    { "type": "text", "id": "h_eyebrow", "label": "Etiqueta", "default": "pronto pra escolher?" },
    { "type": "text", "id": "h_h1", "label": "Título — parte 1", "default": "você já sabe o que quer." },
    { "type": "text", "id": "h_h2", "label": "Título — parte 2 (azul)", "default": "falta só chamar a gente." },
    { "type": "textarea", "id": "h_sub", "label": "Texto", "default": "resposta em minutos, no whatsapp. e tu só paga quando o aparelho tá na tua mão." },
    { "type": "text", "id": "h_cta", "label": "Botão — texto", "default": "vou chamar no whatsapp" },
    { "type": "select", "id": "h_dest", "label": "Botão — destino", "options": [ { "value": "whatsapp", "label": "WhatsApp" }, { "value": "vitrine", "label": "Vitrine" }, { "value": "link", "label": "Link próprio" } ], "default": "whatsapp" },
    { "type": "url", "id": "h_link", "label": "Link próprio (se destino = Link próprio)" },

    { "type": "header", "content": "Vitrine" },
    { "type": "checkbox", "id": "v_show", "label": "Mostrar faixa na vitrine", "default": true },
    { "type": "text", "id": "v_eyebrow", "label": "Etiqueta", "default": "não achou o que procura?" },
    { "type": "text", "id": "v_h1", "label": "Título — parte 1", "default": "se existe," },
    { "type": "text", "id": "v_h2", "label": "Título — parte 2 (azul)", "default": "a gente acha." },
    { "type": "textarea", "id": "v_sub", "label": "Texto", "default": "tem a apple inteira pra ti — manda o modelo que tu quer no whatsapp e a gente encontra, confere e te avisa." },
    { "type": "text", "id": "v_cta", "label": "Botão — texto", "default": "vou chamar no whatsapp" },
    { "type": "select", "id": "v_dest", "label": "Botão — destino", "options": [ { "value": "whatsapp", "label": "WhatsApp" }, { "value": "vitrine", "label": "Vitrine" }, { "value": "link", "label": "Link próprio" } ], "default": "whatsapp" },
    { "type": "url", "id": "v_link", "label": "Link próprio (se destino = Link próprio)" },

