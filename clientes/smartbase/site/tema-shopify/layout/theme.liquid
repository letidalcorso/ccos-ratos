<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07070E">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {{ 'colors_and_type.css' | asset_url | stylesheet_tag }}
  {{ 'kit.css' | asset_url | stylesheet_tag }}
  {{ 'pages.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>

  {%- if settings.meta_pixel_id != blank -%}
  <!-- Meta Pixel -->
  <script>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '{{ settings.meta_pixel_id }}');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id={{ settings.meta_pixel_id }}&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->
  {%- endif -%}

  {{ content_for_header }}
</head>

<body class="sb-body template-{{ request.page_type | handle }}">
  <a class="skip-link" href="#main">pular para o conteúdo</a>
  <div class="sb-canvas sb-bg" aria-hidden="true"></div>

  {% section 'browser-bar' %}
  {% section 'sidebar' %}

  <main id="main" class="site" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'cta-band' %}
  {% section 'footer' %}

  {% render 'wa-float' %}

  <script src="{{ 'global.js' | asset_url }}" defer></script>
  <script src="{{ 'vitrine.js' | asset_url }}" defer></script>
</body>
</html>
