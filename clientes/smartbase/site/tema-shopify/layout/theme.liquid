<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07070E">
  <meta name="google-site-verification" content="HUUP8E2ho6PvnWt9C2_9J4nLnU5KlE0_6zd8RcdwP7k">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- liquid
    # título: só acrescenta o nome da loja se ainda não estiver no título (case-insensitive — evita "smartbase · SmartBase")
    assign _pt = page_title | downcase
    assign _sn = shop.name | downcase
    # meta description com fallback por página (garante descrição em toda página, mesmo sem SEO preenchido no painel)
    assign meta_desc = page_description
    # home: descrição travada em Caxias/Serra (a do painel dizia "atende todo o brasil", o que conflita com o posicionamento presencial / paga-quando-recebe)
    if request.page_type == 'index'
      assign meta_desc = 'smartbase: iPhone, Mac e iPad originais em caxias do sul · rs. novos lacrados com garantia Apple e seminovos conferidos. você paga quando recebe na mão.'
    endif
    if meta_desc == blank
      case request.page_type
        when 'page'
          if page.handle == 'vitrine'
            assign meta_desc = 'iPhone, iPad, Mac, Apple Watch e AirPods originais na smartbase: novos sob encomenda e seminovos conferidos, com garantia. você só paga quando recebe.'
          elsif page.handle == 'faq'
            assign meta_desc = 'garantia, originalidade, entrega e pagamento na smartbase. Apple original com garantia verificável por IMEI, em caxias do sul · rs. tire suas dúvidas.'
          elsif page.handle == 'contato'
            assign meta_desc = 'loja física da smartbase em caxias do sul · rs. passa pra conhecer ou fala no WhatsApp. Apple original, e você só paga quando o aparelho tá na sua mão.'
          endif
        when 'blog'
          assign meta_desc = 'dicas e guias sobre Apple: iPhone importado, garantia no Brasil e seminovos — por quem vive Apple há anos. smartbase, caxias do sul.'
        when 'article'
          assign meta_desc = article.excerpt_or_content | strip_html | truncate: 160
      endcase
    endif
  -%}
  <title>
    {{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless _pt contains _sn %} &middot; {{ shop.name }}{% endunless %}
  </title>

  {% if meta_desc != blank %}
    <meta name="description" content="{{ meta_desc | escape }}">
  {% endif %}

  {%- comment -%} Open Graph / Twitter (capa por artigo) {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if request.page_type == 'article' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {% if meta_desc != blank %}<meta property="og:description" content="{{ meta_desc | escape }}">{% endif %}
  {%- if request.page_type == 'article' and article.image -%}
    <meta property="og:image" content="https:{{ article.image | image_url: width: 1200 }}">
  {%- elsif settings.og_image != blank -%}
    <meta property="og:image" content="https:{{ settings.og_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta property="og:image" content="https:{{ 'og-default.png' | asset_url }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  {%- comment -%} Dados estruturados — negócio local (Caxias). Nos artigos o JSON-LD próprio cuida disso. {%- endcomment -%}
  {%- unless request.page_type == 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Store",
    "name": "SmartBase",
    "image": "https:{{ 'og-default.png' | asset_url }}",
    "url": {{ shop.url | json }},
    "telephone": "+{{ settings.wa_number }}",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rua Sinimbu, 2211, sala 805",
      "addressLocality": "Caxias do Sul",
      "addressRegion": "RS",
      "postalCode": "95020-520",
      "addressCountry": "BR"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": -29.16877, "longitude": -51.17984 },
    "areaServed": "Caxias do Sul e Serra Gaúcha",
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "19:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
    ]{% if settings.instagram_url != blank %},
    "sameAs": [{{ settings.instagram_url | json }}]{% endif %}
  }
  </script>
  {%- endunless -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {{ 'colors_and_type.css' | asset_url | stylesheet_tag }}
  {{ 'kit.css' | asset_url | stylesheet_tag }}
  {{ 'pages.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>

  {%- if settings.meta_pixel_id != blank -%}
  <!-- Meta Pixel -->
  <script>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '{{ settings.meta_pixel_id }}');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id={{ settings.meta_pixel_id }}&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->
  {%- endif -%}

  {{ content_for_header }}
</head>

<body class="sb-body template-{{ request.page_type | handle }}">
  <a class="skip-link" href="#main">pular para o conteúdo</a>
  <div class="sb-canvas sb-bg" aria-hidden="true"></div>

  {% section 'browser-bar' %}
  {% section 'sidebar' %}

  <main id="main" class="site" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'cta-band' %}
  {% section 'footer' %}

  {% render 'wa-float' %}

  <script src="{{ 'global.js' | asset_url }}" defer></script>
  <script src="{{ 'vitrine.js' | asset_url }}" defer></script>
</body>
</html>
